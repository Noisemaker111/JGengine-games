{
  "name": "jgengine-games",
  "private": true,
  "type": "module",
  "description": "Playable games built with JGengine — probe games for engine gaps. Each game is a standalone Vite app on @jgengine/* built from the engine beta commit in engine-ref.txt.",
  "workspaces": {
    "packages": [
      "*"
    ],
    "catalog": {
      "@jgengine/assets": "0.43.0",
      "@jgengine/core": "0.43.0",
      "@jgengine/editor": "0.43.0",
      "@jgengine/node": "0.43.0",
      "@jgengine/react": "0.43.0",
      "@jgengine/shell": "0.43.0",
      "@jgengine/ws": "0.43.0",
      "jgengine": "0.41.0",
      "@react-three/drei": "^10.7.7",
      "@tailwindcss/vite": "^4.0.15",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "@types/three": "^0.182.0",
      "@vitejs/plugin-react": "^4.3.4",
      "tailwindcss": "^4.0.15",
      "typescript": "^5",
      "vite": "^6.2.2"
    }
  },
  "scripts": {
    "engine:local": "bun scripts/engine-mode.ts local",
    "engine:sync": "bun scripts/engine-ref.ts sync",
    "engine:bump": "bun scripts/engine-ref.ts bump",
    "engine:snapshots": "bun scripts/engine-pin.ts snapshots",
    "engine:status": "bun scripts/engine-mode.ts status",
    "engine:watch": "bun scripts/engine-watch.ts",
    "ci:status": "bun scripts/engine-ci-status.ts",
    "verify:fast": "bun scripts/verify-fast.ts",
    "verify:full": "bun scripts/verify-fast.ts --full",
    "lane:close": "bun scripts/lane-close.ts",
    "pr:sweep": "bun scripts/pr-sweep.ts",
    "prove": "bun scripts/prove.ts",
    "bg:run": "bun scripts/bg.ts run",
    "bg:await": "bun scripts/bg.ts await",
    "provision": "bun scripts/provision-assets.ts",
    "new-game": "bun scripts/new-game.ts",
    "test": "bun test",
    "test:games": "bun test",
    "check-types": "bun --filter='*' run check-types",
    "check:framework": "bun scripts/framework-check.ts",
    "check:seam-line": "bun scripts/seam-line-check.ts",
    "check:engine-mode": "bun scripts/engine-mode-check.ts",
    "check:engine-ref": "bun scripts/engine-ref.ts check",
    "check:module-globals": "bun scripts/module-globals-check.ts",
    "check:save-states": "bun scripts/check-save-states.ts",
    "check:glb-textures": "bun scripts/check-glb-textures.ts",
    "check:game-design": "bun scripts/check-game-design.ts",
    "check:capabilities": "bun scripts/check-capabilities.ts",
    "capabilities:sync": "bun scripts/capabilities-sync.ts",
    "capabilities:declare": "bun scripts/capabilities-declare.ts",
    "capabilities:probe": "bun scripts/capabilities-probe.ts",
    "dev:ember-command": "bun --cwd=ember-command run dev",
    "dev:brightway-park": "bun --cwd=brightway-park run dev",
    "dev:odd-orbit": "bun --cwd=odd-orbit run dev",
    "dev:scrap-signal": "bun --cwd=scrap-signal run dev",
    "dev:beacon-bastion": "bun --cwd=beacon-bastion run dev",
    "dev:harbor-heat": "bun --cwd=harbor-heat run dev",
    "dev:drift-foundry": "bun --cwd=drift-foundry run dev",
    "dev:deepward": "bun --cwd=deepward run dev",
    "dev:hold-the-line": "bun --cwd=hold-the-line run dev",
    "dev:fernwild": "bun --cwd=fernwild run dev",
    "dev:apex-nights": "bun --cwd=apex-nights run dev",
    "dev:briarcrown": "bun --cwd=briarcrown run dev",
    "dev:the-sunken-crown": "bun --cwd=the-sunken-crown run dev",
    "dev:outpost-zero": "bun --cwd=outpost-zero run dev",
    "dev:orbit-watch": "bun --cwd=orbit-watch run dev",
    "dev:red-frontier": "bun --cwd=red-frontier run dev",
    "dev:saltwick": "bun --cwd=saltwick run dev"
  },
  "packageManager": "bun@1.3.8",
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "jgengine": "catalog:"
  }
}
