{
  "name": "jgengine-games",
  "private": true,
  "type": "module",
  "description": "Playable games built with JGengine — probe games for engine gaps. Each game is a standalone Vite app on published @jgengine/* packages.",
  "workspaces": {
    "packages": [
      "*"
    ],
    "catalog": {
      "@react-three/drei": "^10.7.7",
      "@tailwindcss/vite": "^4.0.15",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "@types/three": "^0.182.0",
      "@vitejs/plugin-react": "^4.3.4",
      "tailwindcss": "^4.0.15",
      "typescript": "^5",
      "vite": "^6.2.2"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:games": "bun test",
    "check-types": "bun --filter='*' run check-types",
    "dev:lantern-reach": "bun --cwd=lantern-reach run dev",
    "dev:resonant-crossing": "bun --cwd=resonant-crossing run dev",
    "dev:ember-command": "bun --cwd=ember-command run dev",
    "dev:brightway-park": "bun --cwd=brightway-park run dev",
    "dev:wayfarer-deck": "bun --cwd=wayfarer-deck run dev",
    "dev:odd-orbit": "bun --cwd=odd-orbit run dev",
    "dev:field-station": "bun --cwd=field-station run dev",
    "dev:scrap-signal": "bun --cwd=scrap-signal run dev",
    "dev:beacon-bastion": "bun --cwd=beacon-bastion run dev",
    "dev:harbor-heat": "bun --cwd=harbor-heat run dev",
    "dev:drift-foundry": "bun --cwd=drift-foundry run dev",
    "dev:deepward": "bun --cwd=deepward run dev"
  },
  "overrides": {
    "@jgengine/editor": "0.18.0"
  },
  "packageManager": "bun@1.3.8",
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260707.2"
  }
}
